Package: fullmetaphone
Type: Package
Title: Full-Length Metaphone and Double Metaphone Phonetic Codes
Version: 0.1.0
Authors@R: c(
    person("Anil Kumar", "Goyal", email = "anilyayavar@gmail.com",
           role = c("aut", "cre", "cph")),
    person("Atharv", "Tyagi", email = "tatharv597@gmail.com",
           role = c("aut", "cph")),
    person("Lawrence", "Philips", role = "ctb",
           comment = "Designer of the Metaphone and Double Metaphone algorithms and author of their original code"),
    person("Maurice", "Aubrey", role = "ctb",
           comment = "Author of the C implementation of Double Metaphone whose rules are followed here"),
